{
  "name": "ocd",
  "productName": "OCD",
  "version": "0.1.21",
  "description": "OpenCode Deck - acrylic desktop hub for OpenCode: chat, plugins, providers, settings",
  "main": "./out/main/index.js",
  "author": "Sergey35853",
  "license": "MIT",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/Sergey35853/ocd.git"
  },
  "homepage": "https://github.com/Sergey35853/ocd#readme",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:live": "set OCD_LIVE=1&& vitest run diff.live",
    "check": "npm run typecheck && npm run lint && npm run test",
    "pack": "npm run build && electron-builder --dir && node scripts/write-update-channel.mjs",
    "dist": "npm run build && electron-builder"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "electron-updater": "^6.8.9",
    "highlight.js": "^11.12.0",
    "jsonc-parser": "^3.3.1",
    "markdown-it": "^15.0.2"
  },
  "npmRebuild": false,
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^44.0.0",
    "electron-builder": "^25.1.8",
    "electron-vite": "^5.0.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.26",
    "globals": "^17.13.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.71.0",
    "vite": "^7.0.0",
    "vitest": "^3.2.7"
  },
  "build": {
    "appId": "dev.ocd.deck",
    "productName": "OCD",
    "publish": {
      "provider": "github",
      "owner": "Sergey35853",
      "repo": "ocd",
      "releaseType": "release"
    },
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources/voice.py",
        "to": "voice.py"
      },
      {
        "from": "resources/icon.png",
        "to": "icon.png"
      },
      {
        "from": "resources/icon.ico",
        "to": "icon.ico"
      },
      {
        "from": "resources/icon-update.png",
        "to": "icon-update.png"
      },
      {
        "from": "resources/icon-update.ico",
        "to": "icon-update.ico"
      }
    ],
    "win": {
      "icon": "resources/icon.ico",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "OCD"
    },
    "portable": {
      "artifactName": "OCD-portable-${version}.exe"
    }
  }
}
